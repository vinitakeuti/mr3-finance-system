generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MASTER
  CONTADOR
  CONSULTOR
  DESIGNER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CONSULTOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  permissions  FeaturePermission[]

  @@map("users")
}

model AllowedEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  role      Role
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  usedAt    DateTime?

  @@map("allowed_emails")
}

model FeaturePermission {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  feature   String
  canRead   Boolean  @default(true)
  canWrite  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, feature])
  @@map("feature_permissions")
}

enum EntryType {
  INCOME
  EXPENSE
}

model DailyEntry {
  id          String    @id @default(uuid())
  date        DateTime  // the specific day (stored as YYYY-MM-DD 00:00:00)
  type        EntryType
  amount      Decimal
  description String?
  category_id String?   // optional link to CostCategory (for expenses)
  categoryRef CostCategory? @relation(fields: [category_id], references: [id])
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  user_id     String

  @@map("daily_entries")
}

enum CostRecurrence {
  MONTHLY
  ONE_TIME
}

enum CalcType {
  FIXED
  PERCENTAGE
  PER_UNIT
}

model CostCategory {
  id          String   @id @default(uuid())
  name        String
  color       String   @default("#737373") // hex color for UI
  description String?
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  user_id      String
  costs        Cost[]
  dailyEntries DailyEntry[]

  @@unique([user_id, name])
  @@map("cost_categories")
}

model Cost {
  id          String         @id @default(uuid())
  name        String
  description String?
  category    String         // kept for backwards compat / display
  category_id String?
  categoryRef CostCategory?  @relation(fields: [category_id], references: [id])
  recurrence  CostRecurrence @default(MONTHLY)
  month       DateTime?      // for ONE_TIME: specific month (YYYY-MM-01)
  due_day     Int?           // for MONTHLY: day of month

  calc_type       CalcType @default(FIXED)
  amount          Decimal  @default(0) // FIXED: total value; PER_UNIT: rate per unit; PERCENTAGE: rate %
  quantity        Int?         // PER_UNIT: number of units
  reference_value Decimal?     // PERCENTAGE: base value to apply % on
  total           Decimal  @default(0) // computed final value

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user_id    String

  @@map("costs")
}

// ─── Kanban (Tarefas) ────────────────────────────────────────

model KanbanColumn {
  id         String       @id @default(uuid())
  name       String
  color      String       @default("#737373")
  sort_order Int          @default(0)
  user_id    String
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  cards      KanbanCard[]

  @@unique([user_id, name])
  @@map("kanban_columns")
}

model KanbanCard {
  id          String       @id @default(uuid())
  title       String
  description String?
  column_id   String
  column      KanbanColumn @relation(fields: [column_id], references: [id])
  sort_order  Int          @default(0)
  user_id     String
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  @@map("kanban_cards")
}

// ─── Vault (Cofre) ───────────────────────────────────────────

model VaultCategory {
  id          String      @id @default(uuid())
  name        String
  color       String      @default("#737373")
  sort_order  Int         @default(0)
  user_id     String
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  items       VaultItem[]

  @@unique([user_id, name])
  @@map("vault_categories")
}

model VaultItem {
  id          String         @id @default(uuid())
  name        String
  content     String         @default("")
  link        String?
  category_id String?
  categoryRef VaultCategory? @relation(fields: [category_id], references: [id])
  user_id     String
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt

  @@map("vault_items")
}

// Legacy tables kept for migration compatibility
model FixedCost {
  id          String   @id @default(uuid())
  name        String
  description String?
  amount      Decimal
  due_day     Int
  category    String
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  user_id     String

  @@map("fixed_costs")
}

model VariableCost {
  id                   String   @id @default(uuid())
  month                DateTime
  ad_accounts_purchase Decimal  @default(0)
  gateway_percentage   Decimal  @default(0)
  withdrawal_count     Int      @default(0)
  withdrawal_total     Decimal?
  p2p_transfers        Decimal  @default(0)
  p2p_fees             Decimal?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  user_id              String

  @@unique([user_id, month])
  @@map("variable_costs")
}

model SporadicCost {
  id          String   @id @default(uuid())
  name        String
  description String?
  amount      Decimal
  date        DateTime
  category    String?
  created_at  DateTime @default(now())
  user_id     String

  @@map("sporadic_costs")
}

model Revenue {
  id                 String   @id @default(uuid())
  month              DateTime
  total_revenue      Decimal
  sales_count        Int
  traffic_investment Decimal
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  user_id            String

  @@unique([user_id, month])
  @@map("revenue")
}

model PaymentStatus {
  id           String   @id @default(uuid())
  fixed_cost_id String
  month        DateTime
  is_paid      Boolean  @default(false)
  payment_date DateTime?
  amount_paid  Decimal?
  notes        String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  user_id      String

  @@map("payment_status")
}

